# Painel editorial (/admin) — copie para .env.local em dev e cadastre as mesmas
# variáveis no projeto da Vercel para valer em produção.

# Senha única de acesso ao painel, compartilhada pela redação.
ADMIN_SENHA=

# Chave que assina o cookie de sessão. Gere uma com:
#   openssl rand -base64 32
# Trocar essa chave desloga todo mundo na hora.
ADMIN_SESSION_SECRET=

# Token do GitHub usado para commitar a matéria. Use um fine-grained token
# limitado a este repositório, com permissão de leitura e escrita em "Contents".
GITHUB_TOKEN=

# Opcionais — só mude se o repositório ou o branch de produção mudarem.
# GITHUB_REPO=FelipeLopes96/O_Corner
# GITHUB_BRANCH=main

# Domínio público, usado nos canonical e no Open Graph.
# NEXT_PUBLIC_SITE_URL=https://ocorner.com.br
